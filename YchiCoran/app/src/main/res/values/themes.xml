<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Существующая тема -->
    <style name="Base.Theme.YchiCoran" parent="Theme.Material3.DayNight.NoActionBar">
    </style>

    <!-- Новая тема для Splash Screen -->
    <style name="Theme.App.Starting" parent="Theme.SplashScreen">
        <!-- Фон заставки -->
        <item name="windowSplashScreenBackground">@color/green_down_nav</item>
        <item name="paddingEnd">50dp</item>
        <item name="paddingStart">50dp</item>
        <!-- Ваша иконка в центре -->
        <item name="windowSplashScreenAnimatedIcon">@drawable/quran_rehal</item>
        <!-- Тема, которая применится после исчезновения заставки -->
        <item name="postSplashScreenTheme">@style/Theme.YchiCoran</item>
    </style>

    <style name="Theme.YchiCoran" parent="Base.Theme.YchiCoran" />
</resources>