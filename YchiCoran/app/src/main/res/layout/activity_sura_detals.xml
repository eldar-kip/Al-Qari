<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".SuraDetals">

    <include layout="@layout/header_sura_detals" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recycler_suras"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:clipToPadding="false"
        android:paddingTop="10dp"
        app:layout_constraintBottom_toTopOf="@+id/player_container"
        app:layout_constraintTop_toBottomOf="@+id/constraintLayout" />

    <include
        android:id="@+id/player_container"
        layout="@layout/down_audio_pleir"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="parent" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btn_save_playlist"
        android:layout_width="wrap_content"
        android:layout_height="56dp"
        android:layout_margin="16dp"
        android:paddingHorizontal="24dp"
        android:text="@string/save_to_playlist"
        android:textAllCaps="false"
        android:textSize="16sp"
        android:fontFamily="@font/inter"
        android:textColor="@color/white"
        android:visibility="gone"
        app:backgroundTint="@color/background_activ_element"
        app:cornerRadius="28dp"
        app:icon="@android:drawable/ic_menu_save"
        app:iconPadding="8dp"
        app:elevation="8dp"
        app:layout_constraintBottom_toTopOf="@+id/player_container"
        app:layout_constraintEnd_toEndOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
